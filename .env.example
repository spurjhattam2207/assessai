# PostgreSQL connection string
DATABASE_URL="postgresql://assessai:assessai@localhost:5432/assessai?schema=public"

# Auth.js / NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Optional: live question generation. If unset, AssessAI uses a labelled demo fixture.
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
# AI_API_BASE_URL="https://api.openai.com/v1"

# Optional: allow demo reseed from the UI (local only)
ALLOW_DEMO_RESET="true"
